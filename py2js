#!/bin/sh
# Argument 1 : the python file to compile WITHOUT .py EXTENSION

PY=$1.py
JS=$1.js
JSON=$1.json
TMP_SOURCE=$(mktemp "${TMPDIR:-/tmp}/c5-py2js.XXXXXX") || exit 1

cleanup() {
    rm -f "$TMP_SOURCE"
}
trap cleanup EXIT HUP INT TERM

if [ -e $JS ]
then
    mv $JS $JS~
fi
if [ -e $JSON ]
then
    mv $JSON $JSON~
fi

restore() {
    if [ -e $JS~ ]
    then
        mv $JS~ $JS
    fi
    if [ -e $JSON~ ]
    then
        mv $JSON~ $JSON
    fi
    # rm $PY.xxx
}

BEFORE=''
case $1 in
	COMPILE*)
		COMPILER=$(echo $1 | sed -e 's,/.*,,' | tr '[A-Z]' '[a-z]')
		FILES="$PY"
		SESSION=$(
			echo
			echo 'if not Compile.worker: eval("new Session([' \
				 $(grep -E '^class Q[A-Za-z0-9_]+\(' $PY |
                  tr '\n' '%' |
                  sed -r -e 's/%*class *([^%( ]*)\([^%]*/new \1(),/g' -e 's/,%$//'
                 ) '])")'
			)
		[ -d $1 ] && chmod 700 $1
        BEFORE="importScripts('JS/$COMPILER.js' + location.search)"
		;;
    compile_*)
		COMPILER=
		FILES="compatibility.py xxx_local.py options.py compile.py question.py $PY"
		JS=JS/$JS
		;;
    bare_*)
		COMPILER=
		FILES="$PY"
		JS=JS/$JS
		;;
	*)
		COMPILER=
		FILES="compatibility.py xxx_local.py options.py $PY"
		JS=JS/$JS
		;;
esac

echo "$BEFORE" >"$TMP_SOURCE"
if cat $FILES >>"$TMP_SOURCE"
then
    :
else
    restore
    exit 1
fi

echo "$SESSION" >>"$TMP_SOURCE"

if nodejs RapydScript/bin/rapydscript --prettify --bare "$TMP_SOURCE" >$JS
then
    echo "$PY → $JS OK"
    if [ "$COMPILER" != "" ]
        then
        ./rewrite.py $JS
        fi
else
    echo "$PY → $JS FAIL"
    restore
    exit 1
fi

if [ "$COMPILER" != "" ]
then
	if cat options.py compile.py $COMPILER.py question_before.py $PY question_after.py |
		(cd $(dirname $JS) ; python3) >$JSON
    then
        echo "$PY → $JSON OK"
    else
        echo "$PY → $JSON FAIL"
        restore
        exit 1
    fi
fi
